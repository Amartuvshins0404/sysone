generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?     @map("parent_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}
