{
  "name": "sysonejs",
  "version": "0.0.1",
  "description": "Define a data model once. Get endpoints on the server and hooks on the client.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser-guard.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "browser": "./dist/browser-guard.mjs",
      "default": "./dist/node.mjs"
    },
    "./source": {
      "types": "./dist/kit.d.mts",
      "browser": "./dist/browser-guard.mjs",
      "default": "./dist/kit.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
