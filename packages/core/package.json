{
  "name": "sysonejs",
  "version": "0.0.1",
  "description": "Define a data model once. Get endpoints on the server and hooks on the client.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
    "./server": { "types": "./dist/server.d.mts", "default": "./dist/server.mjs" },
    "./client": { "types": "./dist/client.d.mts", "default": "./dist/client.mjs" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
