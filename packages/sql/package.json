{
  "name": "@sysonejs/sql",
  "version": "0.0.1",
  "description": "Raw SQL source for sysonejs: Postgres (pg) and MySQL (mysql2), no ORM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "sysonejs": "workspace:^",
    "pg": ">=8",
    "mysql2": ">=3"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "sysonejs": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amartuvshins0404/sysone.git",
    "directory": "packages/sql"
  },
  "homepage": "https://github.com/Amartuvshins0404/sysone#readme"
}
